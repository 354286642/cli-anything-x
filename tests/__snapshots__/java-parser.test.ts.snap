    "warehouseType": {}, // 所属仓库类型
    "commodityBarcode": "", // 商品条形码
    "commodityName": "", // 商品名称
    "commodityBrandCode": "", // 商品商品编码
    "commodityBrandName": "", // 商品商品名称
    "commodityMallPrice": 0, // 销售价/商城价
    "commodityCostPrice": 0, // 成本价
    "commodityExpirationSplit": [{
      "id": "", // 效期拆分后自身的业务id
      "commodityNum": 0, // 对应的数量
      "expirationRequirement": {}, // 效期要求
      "expirationRequirementName": "", // 效期要求名称
    }], // 记录商品不同效期拆分的数量
    "izLooseSet": "", // 是否套装非捆绑商品. 1是其他否
    "id": "", // 商品id,用于特殊情况下提前设置好商品的id
  }], // 退货商品信息
  "remark": "", // 退货备注
  "sourceCode": "", // 办公室对应的仓库编码。当从仓库领用，且仓库已发出时需要指定值
}",
    "controllerName": "SampleOrderController",
    "description": "取消样品单，待发货状态下",
