        "required": false,
        "source": "body",
        "type": "List<String>",
      },
      {
        "description": "样品单号",
        "name": "code",
        "required": false,
        "source": "body",
        "type": "String",
      },
      {
        "description": "领用用途二级分类id",
        "name": "subPurposeId",
        "required": false,
        "source": "body",
        "type": "Integer",
      },
      {
        "description": "领用用途二级分类id,支持多个",
        "name": "subPurposeIdList",
        "required": false,
        "source": "body",
        "type": "List<Integer>",
      },
      {
        "description": "当领用用途为客户时，对应平台客户ID",
        "name": "customerPlatformId",
        "required": false,
        "source": "body",
        "type": "String",
      },
      {
        "description": "当领用用途为客户或直播间时，对应的平台",
        "name": "platform",
        "required": false,
        "source": "body",
        "type": "LaunchPlatformEnum",
      },
      {
        "description": "平台，支持多个",
        "name": "platformList",
        "required": false,
        "source": "body",
        "type": "List<LaunchPlatformEnum>",
      },
      {
        "description": "当领用用途为自播时，对应自播间ID",
        "name": "selfRoomId",
        "required": false,
        "source": "body",
        "type": "String",
      },
      {
        "description": "商品编码,多个",
        "name": "itemCodeList",
        "required": false,
        "source": "body",
        "type": "List<String>",
      },
      {
        "description": "商品编码,权限控制",
        "name": "itemCodePermissionList",
        "required": false,
        "source": "body",
        "type": "List<String>",
      },
      {
        "description": "样品的样品所在地；仓库、办公室",
        "name": "sampleLocation",
        "required": false,
        "source": "body",
        "type": "SampleOrderLocationEnum",
      },
      {
        "description": "样品状态多个同时查询",
        "name": "statusList",
        "required": false,
        "source": "body",
        "type": "List<SampleOrderStatusEnum>",
      },
      {
        "description": "样品类型,支持多个；WAREHOUSE_SEND 从仓库直接寄出（所在地仓库），COMPANY_PUBLIC_MAIL_SEND送至公司后公件寄出（所在地仓库），COMPANY_SELF_SEND 送至公司后自行寄出（所在地仓库），COMPANY_NO_SEND送至公司后无需邮寄（所在地仓库），PUBLIC_MAIL_SEND公件寄出（所在地办公室），SELF_SEND 自行寄出（所在地办公室），NO_SEND无需邮寄（所在地办公室）",
        "name": "itemTypeList",
        "required": false,
        "source": "body",
        "type": "List<SampleOrderTypeEnum>",
      },
      {
        "description": "样品创建人",
        "name": "createBy",
        "required": false,
        "source": "body",
        "type": "String",
      },
      {
        "description": "样品创建人.支持多个",
        "name": "createByList",
        "required": false,
        "source": "body",
        "type": "List<String>",
      },
      {
        "description": "样品创建开始时间",
        "name": "createTimeStart",
        "required": false,
        "source": "body",
        "type": "Date",
      },
      {
        "description": "样品创建结束时间",
        "name": "createTimeEnd",
        "required": false,
        "source": "body",
        "type": "Date",
      },
      {
        "description": "物流单号",
        "name": "trackingNo",
        "required": false,
        "source": "body",
        "type": "String",
      },
      {
        "description": "OA流程单号",
        "name": "oaProcessCode",
        "required": false,
        "source": "body",
        "type": "String",
      },
      {
        "description": "商品信息搜索。支持完整匹配条形码，模糊搜索商品名称",
        "name": "commodityInfo",
        "required": false,
        "source": "body",
        "type": "String",
      },
      {
        "description": "样品的退回状态。",
        "name": "returnStatus",
        "required": false,
        "source": "body",
        "type": "SampleOrderReturnStatusEnum",
      },
      {
        "description": "发起审核的人",
        "name": "auditCreateBy",
        "required": false,
        "source": "body",
        "type": "String",
      },
      {
        "description": "达播商务，支持多个",
        "name": "daboBusinessList",
        "required": false,
        "source": "body",
        "type": "List<String>",
      },
      {
        "description": "物流异常状态。0 否（样品单所有物流均无异常或已忽略），1 是（样品单所有物流存在任意一个异常的）",
        "name": "deliveryExceptionStatus",
        "required": false,
        "source": "body",
        "type": "String",
      },
      {
        "description": "收货人联系方式。 支持英文逗号分隔多个",
        "name": "consigneePhone",
        "required": false,
        "source": "body",
        "type": "String",
      },
      {
        "description": "收货人联系方式.内部处理搜索",
        "name": "consigneePhoneList",
        "required": false,
        "source": "body",
        "type": "List<String>",
      },
      {
        "description": "样品状态查询，后台赋值使用",
        "name": "defaultStatusList",
        "required": false,
        "source": "body",
        "type": "List<SampleOrderStatusEnum>",
      },
      {
        "description": "领用用途状态查询，后台赋值使用",
        "name": "defaultSubPurposeIdList",
        "required": false,
        "source": "body",
        "type": "List<Integer>",
      },
      {
        "description": "是否仅查询基础数据",
        "name": "izQueryBaseData",
        "required": false,
        "source": "body",
        "type": "Boolean",
      },
      {
        "description": "多个客户id搜索",
        "name": "customerPlatformIds",
        "required": false,
        "source": "body",
        "type": "List<String>",
      },
      {
        "description": "发货时间-开始时间",
        "name": "shippedDateStart",
        "required": false,
        "source": "body",
        "type": "Date",
      },
      {
        "description": "发货时间-结束时间",
        "name": "shippedDateEnd",
        "required": false,
        "source": "body",
        "type": "Date",
      },
      {
        "description": "分组单号. 支持英文逗号分隔多个",
        "name": "planCode",
        "required": false,
        "source": "body",
        "type": "String",
      },
      {
        "description": "隐藏的分组id列表",
        "name": "groupIdList",
        "required": false,
        "source": "body",
        "type": "List<String>",
      },
    ],
    "bodyJsonExample": "{
  "ids": [], // 支持多个样品ID搜索
  "code": "", // 样品单号
  "subPurposeId": 0, // 领用用途二级分类id
  "subPurposeIdList": [], // 领用用途二级分类id,支持多个
  "customerPlatformId": "", // 当领用用途为客户时，对应平台客户ID
  "platform": {}, // 当领用用途为客户或直播间时，对应的平台
  "platformList": [{}], // 平台，支持多个
  "selfRoomId": "", // 当领用用途为自播时，对应自播间ID
  "itemCodeList": [], // 商品编码,多个
  "itemCodePermissionList": [], // 商品编码,权限控制
  "sampleLocation": {}, // 样品的样品所在地；仓库、办公室
  "statusList": [{}], // 样品状态多个同时查询
  "itemTypeList": [{}], // 样品类型,支持多个；WAREHOUSE_SEND 从仓库直接寄出（所在地仓库），COMPANY_PUBLIC_MAIL_SEND送至公司后公件寄出（所在地仓库），COMPANY_SELF_SEND 送至公司后自行寄出（所在地仓库），COMPANY_NO_SEND送至公司后无需邮寄（所在地仓库），PUBLIC_MAIL_SEND公件寄出（所在地办公室），SELF_SEND 自行寄出（所在地办公室），NO_SEND无需邮寄（所在地办公室）
  "createBy": "", // 样品创建人
  "createByList": [], // 样品创建人.支持多个
  "createTimeStart": "2026-01-01", // 样品创建开始时间
  "createTimeEnd": "2026-01-01", // 样品创建结束时间
  "trackingNo": "", // 物流单号
  "oaProcessCode": "", // OA流程单号
  "commodityInfo": "", // 商品信息搜索。支持完整匹配条形码，模糊搜索商品名称
  "returnStatus": {}, // 样品的退回状态。
  "auditCreateBy": "", // 发起审核的人
  "daboBusinessList": [], // 达播商务，支持多个
  "deliveryExceptionStatus": "", // 物流异常状态。0 否（样品单所有物流均无异常或已忽略），1 是（样品单所有物流存在任意一个异常的）
  "consigneePhone": "", // 收货人联系方式。 支持英文逗号分隔多个
  "consigneePhoneList": [], // 收货人联系方式.内部处理搜索
  "defaultStatusList": [{}], // 样品状态查询，后台赋值使用
  "defaultSubPurposeIdList": [], // 领用用途状态查询，后台赋值使用
  "izQueryBaseData": false, // 是否仅查询基础数据
  "customerPlatformIds": [], // 多个客户id搜索
  "shippedDateStart": "2026-01-01", // 发货时间-开始时间
  "shippedDateEnd": "2026-01-01", // 发货时间-结束时间
  "planCode": "", // 分组单号. 支持英文逗号分隔多个
  "groupIdList": [], // 隐藏的分组id列表
}",
