    "bodyJsonExample": "{
  "isConfirm": "", // 0 保存草稿，1 保存并确认需求
  "detailsList": [{
    "subPurposeId": 0, // 领用用途二级分类id
    "customerPlatformId": "", // 当领用用途为客户时，对应平台客户ID
    "homePageUrl": "", // 当领用用途为客户时，对应客户的url
    "selfRoomId": "", // 当领用用途为自播时，对应自播间ID
    "mcnInfoId": "", // 当领用用途为MCN机构时，对应的mcn_info的主键id
    "purposeOfficeWarehouseCode": "", // 领用用途选办公室备样时，对应的办公室编码
    "purposeDesc": "", // 当领用用途不为客户和自播时，对应的具体描述。如活动名称、需求名称、公关原因
    "consigneeName": "", // 收货人姓名。 无需邮寄时为空
    "consigneePhone": "", // 收货人联系方式。
    "consigneeAddress": "", // 收货人详细地址，不包括省市区
    "consigneeProvince": "", // 收货人省
    "consigneeCity": "", // 收货人市
    "consigneeArea": "", // 收货人县区
    "expirationRequirement": {}, // 效期要求。默认30个月以上，可选12个月内（WITHIN_12_MONTHS）/12-24个月（BETWEEN_12_AND_24_MONTHS）/24-30个月（BETWEEN_24_AND_30_MONTHS）/30个月以上（OVER_30_MONTHS）
    "expressRequirement": {}, // 样品物流要求(适用于仓库直接寄出，公件物流要求)
    "publicMailType": {}, // 公件类型。 仓库/办公室公件寄出时需要填写，默认长沙国内件，可选长沙国际件、上海寄出
    "insureStatus": "", // 保价状态。0 不保价。1 保价
    "insureGoodsAmt": 0, // 保价时填入的商品总金额
    "insureAmt": 0, // 实际保价金额。 保价商品金额/100
    "sampleIsNeedReturn": "", // 样品是否需要退回。0 不需要，1 需要
    "remark": "", // 其他备注
    "warehouseRemark": "", // 备注给仓库的发货要求
    "commodityList": [{
      "bizId": "", // 归属样品单或退货单的主键id
      "commodityCode": "", // 商品编码
      "warehouseCode": "", // 所属仓库编码
      "commodityNum": 0, // 商品数量
      "warehouseType": {}, // 所属仓库类型
      "commodityBarcode": "", // 商品条形码
      "commodityName": "", // 商品名称
      "commodityBrandCode": "", // 商品商品编码
      "commodityBrandName": "", // 商品商品名称
      "commodityMallPrice": 0, // 销售价/商城价
      "commodityCostPrice": 0, // 成本价
      "commodityExpirationSplit": [{
        "id": "", // 效期拆分后自身的业务id
        "commodityNum": 0, // 对应的数量
        "expirationRequirement": {}, // 效期要求
        "expirationRequirementName": "", // 效期要求名称
      }], // 记录商品不同效期拆分的数量
      "izLooseSet": "", // 是否套装非捆绑商品. 1是其他否
      "id": "", // 商品id,用于特殊情况下提前设置好商品的id
    }], // 样品商品
    "izCreateCustomer": "", // 是否为本次新增客户。0 不是，1 是； 注意为是时，customerPlatformId不能为空
    "groupId": "", // 关联分组id（来自种草打通样品）
  }], // 同一批次保存的样品单明细
  "itemCode": "", // 商品编码
  "sampleLocation": {}, // 样品的样品所在地；仓库、办公室
  "sourceCode": "", // 样品所在地为办公室时（从办公室领用），办公室对应的仓库编码。
  "itemType": {}, // 样品类型
  "companyConsigneeName": "", // 公司收货人姓名。 寄到公司时有值
  "companyConsigneePhone": "", // 公司收货人联系方式。 寄到公司时有值
  "companyConsigneeAddress": "", // 公司收货人地址。 不包括省市区。寄到公司时有值
  "companyConsigneeProvince": "", // 公司收货人省
  "companyConsigneeCity": "", // 公司收货人市
  "companyConsigneeArea": "", // 公司收货人县区
  "companyExpressRequirement": {}, // 送至公司物流要求；仓库寄到公司时有值
}",
