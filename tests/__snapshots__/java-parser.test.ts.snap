  "statusList": [{}], // 样品状态多个同时查询
  "itemTypeList": [{}], // 样品类型,支持多个；WAREHOUSE_SEND 从仓库直接寄出（所在地仓库），COMPANY_PUBLIC_MAIL_SEND送至公司后公件寄出（所在地仓库），COMPANY_SELF_SEND 送至公司后自行寄出（所在地仓库），COMPANY_NO_SEND送至公司后无需邮寄（所在地仓库），PUBLIC_MAIL_SEND公件寄出（所在地办公室），SELF_SEND 自行寄出（所在地办公室），NO_SEND无需邮寄（所在地办公室）
  "createBy": "", // 样品创建人
  "createByList": [], // 样品创建人.支持多个
  "createTimeStart": "2026-01-01", // 样品创建开始时间
  "createTimeEnd": "2026-01-01", // 样品创建结束时间
  "trackingNo": "", // 物流单号
  "oaProcessCode": "", // OA流程单号
  "commodityInfo": "", // 商品信息搜索。支持完整匹配条形码，模糊搜索商品名称
  "returnStatus": {}, // 样品的退回状态。
  "auditCreateBy": "", // 发起审核的人
  "daboBusinessList": [], // 达播商务，支持多个
  "deliveryExceptionStatus": "", // 物流异常状态。0 否（样品单所有物流均无异常或已忽略），1 是（样品单所有物流存在任意一个异常的）
  "consigneePhone": "", // 收货人联系方式。 支持英文逗号分隔多个
  "consigneePhoneList": [], // 收货人联系方式.内部处理搜索
  "defaultStatusList": [{}], // 样品状态查询，后台赋值使用
